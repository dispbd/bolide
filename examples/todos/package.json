{
  "name": "@bolide/example-todos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bolide dev",
    "start": "NODE_ENV=production tsx src/main.ts",
    "test": "tsx --test --test-force-exit test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:sql": "bolide db sql",
    "db:migrate": "bolide db migrate"
  },
  "bolide": {
    "schema": "src/shared/schema.ts"
  },
  "dependencies": {
    "@bolide/client": "0.0.0",
    "@bolide/core": "0.0.0",
    "@bolide/data": "0.0.0",
    "@bolide/react": "0.0.0",
    "@electric-sql/client": "^1.5.28",
    "@hono/node-server": "^2.1.5",
    "esbuild": "^0.28.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@bolide/cli": "0.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0"
  }
}
