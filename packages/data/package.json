{
  "name": "@bolide/data",
  "version": "0.0.0",
  "description": "Bolide data layer: tables, mutators and shapes shared by the server and the browser",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "bolide-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "bolide-source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=20.6"
  }
}
