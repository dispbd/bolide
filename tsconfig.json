{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "customConditions": [
      "bolide-source"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "spike",
    "packages",
    "examples"
  ],
  "exclude": [
    "packages/*/dist",
    "packages/cli/test/.tmp",
    "examples/*/node_modules"
  ]
}
